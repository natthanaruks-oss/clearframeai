{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearframe-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  }
}
